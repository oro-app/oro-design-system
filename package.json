{
  "name": "@oro/ui",
  "version": "0.1.0",
  "description": "Oro React Native component library. Consumes @oro/tokens.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/web/index.d.ts",
        "import": "./dist/web/index.js",
        "require": "./dist/web/index.cjs"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "react-feather": "^2.0.10"
  },
  "peerDependencies": {
    "@expo/vector-icons": ">=14",
    "@oro/tokens": "*",
    "react": ">=18",
    "react-native": ">=0.74"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "@expo/vector-icons": {
      "optional": true
    }
  },
  "sideEffects": false
}
