{
  "name": "@oro/ui",
  "version": "0.1.0",
  "description": "Oro React Native component library. Consumes @oro/tokens.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/web/index.d.ts",
        "import": "./dist/web/index.js",
        "require": "./dist/web/index.cjs"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "react-feather": "^2.0.10"
  },
  "peerDependencies": {
    "@expo/vector-icons": ">=14",
    "@oro/tokens": "*",
    "react": ">=18",
    "react-native": ">=0.74"
  },
  "devDependencies": {
    "@expo/vector-icons": "^14.0.4",
    "@oro/tokens": "workspace:*",
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "react-native": "0.76.5",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
